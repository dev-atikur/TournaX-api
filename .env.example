# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Frontend origins (comma-separated). Do not use *.
FRONTEND_URL=http://localhost:3000

# Cookies: lax | strict | none  (use none in production with HTTPS + credentials)
COOKIE_SAMESITE=lax

# Access Token
ACCESS_ID_SECRET=your_access_token_secret
ACCESS_ID_EXPIRES_IN=15m

# Refresh Token
LOCAL_ID_SECRET=your_refresh_token_secret
LOCAL_ID_EXPIRES_IN=34560m

# Reset Token
RESET_ID_SECRET=your_reset_token_secret
RESET_ID_EXPIRES_IN=10m

# OTP Session Token
OTP_ID_SECRET=your_otp_token_secret
OTP_ID_EXPIRES_IN=5m

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# SMS OTP (Twilio Verify)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Optional
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
MAX_BODY_SIZE=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=10
