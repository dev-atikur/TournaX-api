# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Access Token
ACCESS_ID_SECRET=your_access_token_secret
ACCESS_ID_EXPIRES_IN=15m

# Refresh Token
LOCAL_ID_SECRET=your_refresh_token_secret
LOCAL_ID_EXPIRES_IN=34560m

# Reset Token
RESET_ID_SECRET=your_reset_token_secret
RESET_ID_EXPIRES_IN=10m

# OTP Session Token
OTP_ID_SECRET=your_otp_token_secret
OTP_ID_EXPIRES_IN=5m

# Email Otp service
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# SMS Otp service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Imagekit
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key